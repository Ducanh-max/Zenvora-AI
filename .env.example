NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Keep provider keys server-side only. Never use NEXT_PUBLIC_ for these.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# PayOS credentials (server-side only; never prefix with NEXT_PUBLIC_)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public canonical URL used in PayOS return/cancel URLs
NEXT_PUBLIC_SITE_URL=https://your-aunora-domain.vercel.app
